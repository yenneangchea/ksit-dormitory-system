# Supabase server connection. Use a service-role key only in this backend; never expose it to the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# HTTP server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Authentication/session configuration
JWT_SECRET=replace_with_a_random_32_character_or_longer_secret

# Telegram Mini App authentication (server-only; do not expose these values to the browser)
TELEGRAM_BOT_TOKEN=replace_with_your_telegram_bot_token
TELEGRAM_AUTH_MAX_AGE_SECONDS=600

# Required only when running `npm run seed:demo-accounts`; never commit real password values.
KSIT_DEMO_ADMIN_PASSWORD=
KSIT_DEMO_MANAGER_PASSWORD=
KSIT_DEMO_TEACHER_PASSWORD=
KSIT_DEMO_STUDENT_PASSWORD=

# Currency and payment settings
KHR_PER_USD=4100
KHQR_MERCHANT_ID=your_bakong_merchant_id
KHQR_MERCHANT_NAME=KSIT Dormitory
# Optional secure server-side adapter. When omitted, the API emits a clearly marked development payment reference.
KHQR_GENERATOR_URL=
KHQR_GENERATOR_TOKEN=
