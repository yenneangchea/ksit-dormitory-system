# Supabase server connection. Keep the service-role key exclusively in this backend.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_publishable_or_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# HTTP server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Authentication/session configuration
JWT_SECRET=replace_with_a_random_32_character_or_longer_secret

# Telegram Mini App authentication (server-only; do not expose these values to the browser)
TELEGRAM_BOT_TOKEN=replace_with_your_telegram_bot_token
TELEGRAM_AUTH_MAX_AGE_SECONDS=600

# Google Drive service account. Use a JSON key file or the email/private-key pair below.
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_SERVICE_ACCOUNT_EMAIL=service-account@your-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace_me\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_APPROVED_STUDENTS_FOLDER_ID=
GOOGLE_DRIVE_ATTENDANCE_FOLDER_ID=
GOOGLE_DRIVE_BILLING_FOLDER_ID=

# Existing optional Google Drive document workflow compatibility.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Required only when running `npm run seed:demo-accounts`; never commit real password values.
KSIT_DEMO_ADMIN_PASSWORD=
KSIT_DEMO_MANAGER_PASSWORD=
KSIT_DEMO_TEACHER_PASSWORD=
KSIT_DEMO_STUDENT_PASSWORD=

# Currency and payment settings
KHR_PER_USD=4100
KHQR_MERCHANT_ID=your_bakong_merchant_id
KHQR_MERCHANT_NAME=KSIT Dormitory
# Optional secure server-side adapter. When omitted, the API emits a clearly marked development payment reference.
KHQR_GENERATOR_URL=
KHQR_GENERATOR_TOKEN=
